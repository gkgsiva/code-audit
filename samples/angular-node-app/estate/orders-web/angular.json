{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "orders-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {"outputPath": "dist/orders-web", "browser": "src/main.ts", "styles": ["src/styles.scss"]}
        }
      }
    }
  }
}
