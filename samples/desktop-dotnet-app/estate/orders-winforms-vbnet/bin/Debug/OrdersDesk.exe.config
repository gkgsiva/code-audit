<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="Orders" connectionString="Data Source=ORDSRV02\SQL2008;Initial Catalog=ORDERS;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="PricingServiceUrl" value="http://pricing.acme.local/PricingService.svc" />
  </appSettings>
  <system.serviceModel>
    <client>
      <endpoint address="http://pricing.acme.local/PricingService.svc" binding="basicHttpBinding" contract="Pricing.IPricingService" name="BasicHttpBinding_IPricingService" />
    </client>
  </system.serviceModel>
</configuration>
