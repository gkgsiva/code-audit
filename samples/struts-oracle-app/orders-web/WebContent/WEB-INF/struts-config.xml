<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE struts-config PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 1.2//EN"
    "http://jakarta.apache.org/struts/dtds/struts-config_1_2.dtd">
<struts-config>
    <form-beans>
        <form-bean name="loginForm" type="com.acme.orders.form.LoginForm"/>
        <form-bean name="orderSearchForm" type="com.acme.orders.form.OrderSearchForm"/>
    </form-beans>

    <global-forwards>
        <forward name="error" path="/jsp/error.jsp"/>
        <forward name="login" path="/jsp/login.jsp"/>
    </global-forwards>

    <action-mappings>
        <action path="/login" type="com.acme.orders.action.LoginAction"
                name="loginForm" scope="request" validate="true" input="/jsp/login.jsp">
            <forward name="success" path="/orderSearch.do" redirect="true"/>
            <forward name="failure" path="/jsp/login.jsp"/>
        </action>
        <action path="/orderSearch" type="com.acme.orders.action.OrderSearchAction"
                name="orderSearchForm" scope="session" validate="false">
            <forward name="success" path="/jsp/orderSearch.jsp"/>
        </action>
        <action path="/orderDetail" type="com.acme.orders.action.OrderDetailAction">
            <forward name="success" path="/jsp/orderDetail.jsp"/>
            <forward name="notFound" path="/jsp/error.jsp"/>
        </action>
    </action-mappings>

    <message-resources parameter="com.acme.orders.ApplicationResources"/>

    <plug-in className="org.apache.struts.tiles.TilesPlugin">
        <set-property property="definitions-config" value="/WEB-INF/tiles-defs.xml"/>
    </plug-in>
</struts-config>
