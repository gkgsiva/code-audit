CREATE OR REPLACE PACKAGE BODY PKG_ORDER_PRICING AS

  FUNCTION TOTAL_WITH_TAX(P_ORDER_ID IN NUMBER) RETURN NUMBER IS
    V_TOTAL NUMBER;
  BEGIN
    SELECT SUM(L.QTY * L.UNIT_PRICE) * 1.2
      INTO V_TOTAL
      FROM ORDER_LINES L
     WHERE L.ORDER_ID = P_ORDER_ID;
    RETURN NVL(V_TOTAL, 0);
  END TOTAL_WITH_TAX;

  /* Recalculate every open order; run nightly */
  PROCEDURE RECALC_ALL IS
  BEGIN
    FOR R IN (SELECT ORDER_ID FROM ORDERS WHERE STATUS = 'NEW') LOOP
      UPDATE ORDERS SET TOTAL = TOTAL_WITH_TAX(R.ORDER_ID)
       WHERE ORDER_ID = R.ORDER_ID;
    END LOOP;
    COMMIT;
  END RECALC_ALL;

END PKG_ORDER_PRICING;
/
