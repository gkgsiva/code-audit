//ORDNIGHT JOB (ACCT01),'NIGHTLY ORDERS',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*----------------------------------------------------------------*
//* NIGHTLY ORDER CHAIN: EXTRACT, SORT, REPORT                     *
//*----------------------------------------------------------------*
//STEP010  EXEC PGM=ORDBATCH
//STEPLIB  DD DSN=PROD.ORDERS.LOADLIB,DISP=SHR
//ORDIN    DD DSN=PROD.ORDERS.DAILY,DISP=SHR
//ORDOUT   DD DSN=PROD.ORDERS.SHIPPED(+1),
//            DISP=(NEW,CATLG,DELETE),SPACE=(CYL,(5,5))
//STEP020  EXEC PGM=SORT
//SORTIN   DD DSN=PROD.ORDERS.SHIPPED(+1),DISP=SHR
//SORTOUT  DD DSN=PROD.ORDERS.SHIPPED.SORTED,DISP=(NEW,CATLG)
//SYSIN    DD *
  SORT FIELDS=(1,8,CH,A)
