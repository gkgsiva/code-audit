* ORDER INQUIRY MAPSET
ORDMS1   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,CTRL=FREEKB,             X
               STORAGE=AUTO,TIOAPFX=YES
ORDM01   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,30),LENGTH=13,ATTRB=(ASKIP,BRT),INITIAL='ORDER INQUIRY'
         DFHMDF POS=(4,2),LENGTH=12,ATTRB=ASKIP,INITIAL='ORDER NUMBER'
ORDNO    DFHMDF POS=(4,16),LENGTH=8,ATTRB=(UNPROT,NUM,IC)
MSG      DFHMDF POS=(23,2),LENGTH=60,ATTRB=(ASKIP,BRT)
ORDM02   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,30),LENGTH=13,ATTRB=(ASKIP,BRT),INITIAL='ORDER DETAILS'
ORDNO2   DFHMDF POS=(4,16),LENGTH=8,ATTRB=ASKIP
CUSTNM   DFHMDF POS=(5,16),LENGTH=40,ATTRB=ASKIP
AMOUNT   DFHMDF POS=(6,16),LENGTH=12,ATTRB=ASKIP
         DFHMSD TYPE=FINAL
         END
