000100 IDENTIFICATION DIVISION.
000200 PROGRAM-ID. ORDRPT.
000300*----------------------------------------------------------------*
000400* DAILY ORDER REPORT (DB2, RUN UNDER IKJEFT01)                   *
000500*----------------------------------------------------------------*
000600 ENVIRONMENT DIVISION.
000700 INPUT-OUTPUT SECTION.
000800 FILE-CONTROL.
000900     SELECT REPORT-FILE ASSIGN TO UT-S-RPTOUT.
001000 DATA DIVISION.
001100 FILE SECTION.
001200 FD  REPORT-FILE.
001300 01  RPT-LINE               PIC X(132).
001400 WORKING-STORAGE SECTION.
001500 01  WS-TOTAL               PIC S9(11)V99 COMP-3.
001600 01  WS-REGION              PIC X(4).
001700 01  WS-SORT-COL            PIC X(20).
001800 01  WS-BASE-SQL            PIC X(80) VALUE
001900     'SELECT ORD_ID, ORD_AMOUNT FROM ORDERS WHERE ORD_DATE = ?'.
002000 01  WS-DYN-SQL.
002100     49 WS-DYN-SQL-LEN      PIC S9(4) COMP.
002200     49 WS-DYN-SQL-TEXT     PIC X(500).
002300     EXEC SQL INCLUDE SQLCA END-EXEC.
002400 PROCEDURE DIVISION.
002500 MAIN-PARA.
002600     OPEN OUTPUT REPORT-FILE.
002700     EXEC SQL
002800         SELECT SUM(ORD_AMOUNT) INTO :WS-TOTAL
002900           FROM ORDERS
003000          WHERE ORD_DATE = CURRENT DATE
003100          FETCH FIRST 1 ROW ONLY
003200     END-EXEC.
003300     WRITE RPT-LINE FROM WS-TOTAL.
003400     PERFORM DETAIL-PARA.
003500     CLOSE REPORT-FILE.
003600     STOP RUN.
003700 DETAIL-PARA.
003800*   OPTIONAL REGION FILTER AND A SORT COLUMN FROM THE JCL PARM.
003900     ACCEPT WS-REGION.
004000     ACCEPT WS-SORT-COL.
004100     MOVE WS-BASE-SQL TO WS-DYN-SQL-TEXT
004200     IF WS-REGION NOT = SPACES
004300        STRING WS-DYN-SQL-TEXT DELIMITED BY '  '
004400               ' AND ORD_REGION = ''' WS-REGION ''''
004500               DELIMITED BY SIZE INTO WS-DYN-SQL-TEXT
004600        END-STRING
004700     END-IF
004800     STRING WS-DYN-SQL-TEXT DELIMITED BY '  '
004900            ' ORDER BY ' WS-SORT-COL
005000            DELIMITED BY SIZE INTO WS-DYN-SQL-TEXT.
005100     EXEC SQL PREPARE RPTSTMT FROM :WS-DYN-SQL END-EXEC.
005200     EXEC SQL DECLARE RPTCUR CURSOR FOR RPTSTMT END-EXEC.
