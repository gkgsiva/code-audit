000100 IDENTIFICATION DIVISION.
000200 PROGRAM-ID. ORDBATCH.
000300*----------------------------------------------------------------*
000400* NIGHTLY ORDER EXTRACT: READS ORDIN, WRITES SHIPPED ORDERS      *
000500*----------------------------------------------------------------*
000600 ENVIRONMENT DIVISION.
000700 INPUT-OUTPUT SECTION.
000800 FILE-CONTROL.
000900     SELECT ORDER-IN  ASSIGN TO ORDIN.
001000     SELECT ORDER-OUT ASSIGN TO ORDOUT.
001100 DATA DIVISION.
001200 FILE SECTION.
001300 FD  ORDER-IN.
001400     COPY ORDREC.
001500 FD  ORDER-OUT.
001600 01  OUT-REC                PIC X(80).
001700 WORKING-STORAGE SECTION.
001800 01  WS-EOF                 PIC X VALUE 'N'.
001900 01  WS-DATE-PGM            PIC X(8) VALUE 'DATECONV'.
002000 01  WS-ISO-DATE            PIC X(10).
002100     EXEC SQL INCLUDE SQLCA END-EXEC.
002200     EXEC SQL DECLARE SHIP-CUR CURSOR FOR
002300         SELECT ORD_ID, SHIP_DATE
002400           FROM SHIPMENTS
002500          WHERE SHIP_DATE = CURRENT DATE
002600     END-EXEC.
002700 PROCEDURE DIVISION.
002800 MAIN-PARA.
002900     OPEN INPUT ORDER-IN
003000          OUTPUT ORDER-OUT.
003100     EXEC SQL OPEN SHIP-CUR END-EXEC.
003200     PERFORM READ-ORDER UNTIL WS-EOF = 'Y'.
003300     EXEC SQL CLOSE SHIP-CUR END-EXEC.
003400     CLOSE ORDER-IN ORDER-OUT.
003500     STOP RUN.
003600 READ-ORDER.
003700     READ ORDER-IN AT END MOVE 'Y' TO WS-EOF.
003800     IF WS-EOF = 'N'
003900        CALL WS-DATE-PGM USING ORD-DATE WS-ISO-DATE
004000        EXEC SQL
004100            UPDATE ORDERS SET ORD_STATUS = 'S'
004200             WHERE ORD_ID = :ORD-ID
004300        END-EXEC
004400        WRITE OUT-REC FROM ORDER-REC
004500     END-IF.
