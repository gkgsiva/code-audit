{
  // Validate legacy-audit from VS Code: Terminal > Run Task... (see docs/validate-in-vscode.md).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "audit: 1. start the web app (Docker)",
      "detail": "Builds the frontend, backend and database containers from docker-compose.yml; open http://localhost:8770 and log in as admin",
      "type": "shell",
      "command": "docker compose up -d --build; docker compose ps",
      "problemMatcher": []
    },
    {
      "label": "audit: 2. stop the web app (Docker)",
      "detail": "Stops the three containers; users and settings stay in the database volume",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    },
    {
      "label": "audit: 3. build the web app and save build.log",
      "detail": "Builds with the settings in .env and keeps the whole output in build.log (send it when the build fails)",
      "type": "shell",
      "command": "docker compose build --progress=plain 2>&1 | tee build.log",
      "problemMatcher": []
    },
    {
      "label": "audit: 4. backend build and tests (Java 25, Maven)",
      "detail": "Compiles the Maven modules and runs their tests; needs Java 25 and Maven on this machine",
      "type": "shell",
      "command": "mvn -B verify",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "audit: 5. frontend build and tests (Node.js)",
      "detail": "Installs the Angular packages, runs the tests and builds; needs Node.js 22 on this machine",
      "type": "shell",
      "command": "npm ci --no-audit --no-fund && npx ng test --watch=false && npx ng build",
      "windows": {
        "command": "cmd /c \"npm ci --no-audit --no-fund && npx ng test --watch=false && npx ng build\""
      },
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "audit: 6. parser proof report",
      "detail": "Runs JavaParser, tree-sitter and JSqlParser over the sample apps and prints the results (after task 4)",
      "type": "shell",
      "command": "java -jar audit-cli/target/legacy-audit.jar proofs --samples ../samples",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "audit: 7. scan a sample app (command line)",
      "detail": "Scans one of the sample apps with the command-line jar and prints the counts (after task 4)",
      "type": "shell",
      "command": "java -jar audit-cli/target/legacy-audit.jar scan -c ../samples/${input:sample}/audit.yaml -o target/sample-scans/${input:sample}",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "audit: 8. compare the analyzers with the Python tool",
      "detail": "Runs every ported analyzer on the sample apps and on the cases recorded from the Python tool, and fails on any difference",
      "type": "shell",
      "command": "mvn -B -pl audit-engine -am test \"-Dtest=AnalyzerParityTest,CaseParityTest,SqlToolsParityTest\" \"-Dsurefire.failIfNoSpecifiedTests=false\"",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "audit: 9. build the developer reference (Javadoc)",
      "detail": "Writes the class reference of all backend modules to backend/target/reports/apidocs/index.html (open it in a browser)",
      "type": "shell",
      "command": "mvn -B javadoc:aggregate",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "audit: 10. compare whole runs with the Python tool",
      "detail": "Scans every sample app and compares all result files (findings, libraries, effort, SBOM, summary) and the SQL-to-PostgreSQL conversions with the Python tool, and checks each expected.yaml",
      "type": "shell",
      "command": "mvn -B -pl audit-engine -am test \"-Dtest=RunParityTest,ExpectedTest,PgCorpusTest\" \"-Dsurefire.failIfNoSpecifiedTests=false\"",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "audit: 11. compare the last two scans of a sample app",
      "detail": "Shows what changed between the two newest scans of a sample made with task 7 (added, removed and changed records)",
      "type": "shell",
      "command": "java -jar audit-cli/target/legacy-audit.jar diff previous latest -o target/sample-scans/${input:sample}",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "audit: 12. compare the reports with the Python tool",
      "detail": "Builds the four HTML reports from sample runs and compares every file with what the Python tool wrote; also checks the PDF helpers",
      "type": "shell",
      "command": "mvn -B -pl audit-reports -am test \"-Dtest=ReportParityTest,JinjaTest,PdfReportsTest\" \"-Dsurefire.failIfNoSpecifiedTests=false\"",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "audit: 13. build the reports of a sample app",
      "detail": "Builds the technical, functional, management and summary reports and their PDFs for the newest scan of a sample made with task 7",
      "type": "shell",
      "command": "java -jar audit-cli/target/legacy-audit.jar report -t all -c ../samples/${input:sample}/audit.yaml -o target/sample-scans/${input:sample}",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "audit: 14. compare the AI and Copilot parts with the Python tool",
      "detail": "Checks the enrichment validator, the prompts sent to a model, the MCP server answers and the Copilot files against the Python tool, and a whole enrichment against a fake model for each provider type",
      "type": "shell",
      "command": "mvn -B -pl audit-ai -am test \"-Dtest=ValidateParityTest,McpParityTest,PromptParityTest,CopilotFilesTest,EnrichTest\" \"-Dsurefire.failIfNoSpecifiedTests=false\"",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "audit: 15. check the AI enrichment of a sample app",
      "detail": "Validates the enrichment of the newest scan of a sample made with task 7 and lists each stage as valid, invalid, missing or stale",
      "type": "shell",
      "command": "java -jar audit-cli/target/legacy-audit.jar validate -c ../samples/${input:sample}/audit.yaml -o target/sample-scans/${input:sample}",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "audit: 16. write the AI enrichment of a sample app with a model",
      "detail": "Runs the missing and stale enrichment stages of the newest scan of a sample with the model you name (the API key comes from OPENAI_API_KEY, ANTHROPIC_API_KEY or AZURE_OPENAI_API_KEY)",
      "type": "shell",
      "command": "java -jar audit-cli/target/legacy-audit.jar enrich --stale --provider ${input:aiProvider} --model \"${input:aiModel}\" --base-url \"${input:aiBaseUrl}\" -c ../samples/${input:sample}/audit.yaml -o target/sample-scans/${input:sample}",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "audit: 17. compare the settings page and component picker with the Python tool",
      "detail": "Checks that saving settings and component choices writes the same audit.yaml and audit-overrides.yaml as the Python tool, and that the component picker finds the same components in all ten samples",
      "type": "shell",
      "command": "mvn -B -pl audit-engine -am test \"-Dtest=WorkspaceParityTest\" \"-Dsurefire.failIfNoSpecifiedTests=false\"",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "audit: 18. check the tools on this computer",
      "detail": "Runs legacy-audit doctor for a sample: Java, output folder, browser for PDFs, Dependency-Check, OSV-Scanner, jdeps, Git and the AI model",
      "type": "shell",
      "command": "java -jar audit-cli/target/legacy-audit.jar doctor -c ../samples/${input:sample}/audit.yaml",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "sample",
      "type": "pickString",
      "description": "Sample app to scan",
      "options": ["struts-oracle-app", "spring-mvc-batch-app", "maven-multimodule-app", "legacy-layout-app", "c-proc-batch",
        "cobol-cics-db2", "angular-node-app", "web-services-app", "desktop-dotnet-app", "java-swing-app"],
      "default": "struts-oracle-app"
    },
    {
      "id": "aiProvider",
      "type": "pickString",
      "description": "Where the model runs",
      "options": ["openai", "azure-openai", "anthropic", "ollama"],
      "default": "openai"
    },
    {
      "id": "aiModel",
      "type": "promptString",
      "description": "Model name (for Azure: the deployment name)",
      "default": "gpt-4o"
    },
    {
      "id": "aiBaseUrl",
      "type": "promptString",
      "description": "Endpoint address; leave empty for the provider's usual one (Azure needs https://<resource>.openai.azure.com)",
      "default": ""
    }
  ]
}
