# Copy to .env next to docker-compose.yml and fill in. Never commit the filled-in file.
LEGACY_AUDIT_SESSION_SECRET=change-me-to-a-long-random-string
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GIT_TOKEN=

# ---- Folders on your machine (kept outside the container) ----
# Projects, reports, logs and settings. Create the folder first. Use forward slashes on Windows.
AUDITS_DIR=./audits
# The code to scan (read-only for the site).
SOURCES_DIR=./sources
# Docker Engine on Linux or WSL2 only: your user and group id (run: id -u and id -g), so the
# site can write the audits folder. Leave 10001 with Docker Desktop on Windows.
AUDIT_UID=10001
AUDIT_GID=10001

# ---- Company network (only if the build or Git clones fail at the office) ----
# Proxy used while the image is built, and while the site runs. Usually the same address.
# Ask IT, or look in Windows: Settings > Network & internet > Proxy.
BUILD_PROXY=
BUILD_NO_PROXY=
RUN_PROXY=
RUN_NO_PROXY=localhost,127.0.0.1
# Company mirrors, if the public servers are blocked (ask IT for the addresses).
APT_MIRROR=
APT_SECURITY_MIRROR=
PIP_INDEX_URL=
NPM_REGISTRY=
# The base image from a company registry, if Docker Hub is blocked.
BASE_IMAGE=python:3.12-slim

# ---- What goes into the image ----
# false = no Debian packages at all: builds even when deb.debian.org is blocked, but then
# there is no Git (only folders under /sources), no PDF copies and no diagram pictures.
WITH_SYSTEM_PACKAGES=true
WITH_CHROMIUM=true
WITH_MERMAID=true
WITH_OSV=true

# ---- Spring Boot and Angular version (docker-compose.spring.yml) ----
# Port of the new web app (the Python version uses 8765).
WEB_PORT=8770
# Password of its PostgreSQL database (set it before the first start).
LEGACY_AUDIT_DB_PASSWORD=change-me-too
# The company Maven repository, if Maven Central is blocked (Nexus, Artifactory).
MAVEN_MIRROR=
# The images from a company registry, if Docker Hub is blocked.
POSTGRES_IMAGE=postgres:17-alpine
BACKEND_BUILD_IMAGE=maven:3.9-eclipse-temurin-25
BACKEND_BASE_IMAGE=eclipse-temurin:25-jre
FRONTEND_BUILD_IMAGE=node:22-alpine
FRONTEND_BASE_IMAGE=nginx:1.29-alpine
