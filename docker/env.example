# Copy to .env next to docker-compose.yml and fill in. Never commit the filled-in file.
# Keys of the AI providers (AI enrichment page) and a read-only Git token (for Git projects).
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GIT_TOKEN=
# OWASP Dependency-Check's NVD database (Admin > Health > Update the database now). A free NVD
# API key makes the first download take minutes instead of hours:
# https://nvd.nist.gov/developers/request-an-api-key. Or the address of a company copy of the
# NVD data feed (NVD_MIRROR_URL). VULNDB_REFRESH: time of the nightly refresh, off for none.
NVD_API_KEY=
NVD_MIRROR_URL=
VULNDB_REFRESH=02:00
# The model the site's AI enrichment page calls, for every project whose audit.yaml has no ai:
# section: openai, anthropic, azure-openai or ollama, the model name and, if needed, the endpoint.
# Empty: Copilot in VS Code writes the enrichment and the page shows the prompt to paste.
LEGACY_AUDIT_AI_PROVIDER=
LEGACY_AUDIT_AI_MODEL=
LEGACY_AUDIT_AI_BASE_URL=

# ---- The web app ----
# Port to open in the browser: http://localhost:8770
WEB_PORT=8770
# Password of the PostgreSQL database (set it before the first start).
LEGACY_AUDIT_DB_PASSWORD=change-me
# User names that are always admins (comma-separated).
LEGACY_AUDIT_ADMINS=admin
# Scans, report builds and AI runs at the same time (more wait their turn) and runs kept per
# project. Leave empty to set them on the Admin page; a number here fixes them.
MAX_SCANS=
KEEP_RUNS=

# ---- Folders on your machine (kept outside the containers) ----
# Projects, scan results and logs. Create the folder first. Use forward slashes on Windows.
AUDITS_DIR=./audits
# The code to scan (read-only for the app).
SOURCES_DIR=./sources
# Docker Engine on Linux or WSL2 only: your user and group id (run: id -u and id -g), so the
# app can write the audits folder. Leave 10001 with Docker Desktop on Windows.
AUDIT_UID=10001
AUDIT_GID=10001

# ---- Company network (only if the build fails at the office) ----
# Proxy used while the images are built, and while the app runs. Usually the same address.
# Ask IT, or look in Windows: Settings > Network & internet > Proxy.
BUILD_PROXY=
BUILD_NO_PROXY=
RUN_PROXY=
RUN_NO_PROXY=localhost,127.0.0.1
# Company mirrors, if the public servers are blocked (Nexus, Artifactory; ask IT).
MAVEN_MIRROR=
NPM_REGISTRY=
# Company Debian mirror for the backend's packages (Git, Chromium, fonts), e.g.
# https://nexus.example.com/repository/debian (security updates: APT_SECURITY_MIRROR).
APT_MIRROR=
APT_SECURITY_MIRROR=
# What goes into the backend image. false when it cannot be downloaded at the office:
# WITH_SYSTEM_PACKAGES (Git projects, PDFs, fonts), WITH_CHROMIUM (PDF copies of the reports),
# WITH_OSV (OSV-Scanner for dependency vulnerabilities, from github.com),
# WITH_DEPENDENCY_CHECK (OWASP Dependency-Check, from the Maven repository or MAVEN_MIRROR).
WITH_SYSTEM_PACKAGES=true
WITH_CHROMIUM=true
WITH_OSV=true
WITH_DEPENDENCY_CHECK=true
DEPENDENCY_CHECK_VERSION=13.0.0
# The images from a company registry, if Docker Hub is blocked.
POSTGRES_IMAGE=postgres:17-alpine
BACKEND_BUILD_IMAGE=maven:3.9-eclipse-temurin-25
BACKEND_JRE_IMAGE=eclipse-temurin:25-jre
BACKEND_BASE_IMAGE=debian:trixie-slim
FRONTEND_BUILD_IMAGE=node:22-alpine
FRONTEND_BASE_IMAGE=nginx:1.29-alpine
