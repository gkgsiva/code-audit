    "a",
    "b",
    "c"
   ]
  },
  "expected": "1:a, 2:b, 3:c"
 },
 {
  "template": "{% for k, v in m.items() %}[{{k}}={{v}}]{% else %}none{% endfor %}|{% for x in [] %}x{% else %}empty{% endfor %}",
  "context": {
