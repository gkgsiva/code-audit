    "z": 1,
    "a": [
     1,
     2
    ]
   }
  },
  "expected": "[z=1][a=[1, 2]]|empty"
 },
 {
  "template": "{{ xs|join(', ') }}|{{ xs|length }}|{{ (xs|list)[1:] }}|{{ s[:3] }}|{{ s[-2:] }}",
  "context": {
   "xs": [
    3,
    1,
    2
   ],
   "s": "abcdef"
  },
  "expected": "3, 1, 2|3|[1, 2]|abc|ef"
 },
 {
