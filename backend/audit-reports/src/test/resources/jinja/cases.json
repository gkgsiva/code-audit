   "b": 2.5,
   "c": "x<&>'\"",
   "d": null,
   "e": true
  },
  "expected": "1 2.5 x&lt;&amp;&gt;&#39;&#34; None True  "
 },
 {
  "template": "{% for x in xs %}{{ loop.index }}:{{ x }}{% if not loop.last %}, {% endif %}{% endfor %}",
  "context": {
