<?xml version="1.0" encoding="UTF-8"?>
<!-- AI and Copilot: the enrichment validator, `init` (Copilot files), the MCP server and the AI
     model clients of `enrich`. Plain Java: no Spring. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.legacyaudit</groupId>
    <artifactId>legacy-audit-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>audit-ai</artifactId>
  <name>audit-ai</name>

  <dependencies>
    <dependency>
      <groupId>com.legacyaudit</groupId>
      <artifactId>audit-reports</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The enrichment JSON Schemas `init` installs for Copilot (same files as the Python tool). -->
      <resource>
        <directory>${project.basedir}/../../schemas/enrichment</directory>
        <targetPath>legacyaudit/ai/schemas</targetPath>
      </resource>
    </resources>
  </build>
</project>
