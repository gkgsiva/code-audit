# build output and downloaded packages
backend/**/target/
node_modules/
frontend/dist/
frontend/.angular/
# the Angular app installs from its lock file (npm ci, decision 198)
package-lock.json
!frontend/package-lock.json
# the Angular/Node sample keeps its lock files: the scan reads them (decision 129)
!samples/*/estate/**/package-lock.json

# scan outputs of the sample apps
samples/*/audit-output/
samples/*/.github/
samples/*/.vscode/

# docker compose settings, host folders and build logs
.env
/sources/
/audits/
build.log

# Company certificates are copied in locally and never committed
docker/certs/*
!docker/certs/README.txt
