{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "description": "Where a fact was found. ``line`` is None when the fact is about the whole file.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        }
      },
      "required": [
        "file"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "upgrade, use-bom, migrate-jakarta, replace, rewrite, remove or keep",
          "title": "Action",
          "type": "string"
        },
        "effort": {
          "default": "low",
          "description": "low, medium or high",
          "title": "Effort",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "recipe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OpenRewrite recipe id, when one applies",
          "title": "Recipe"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule in dependency-upgrades.yaml",
          "title": "Rule"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target coordinates or product",
          "title": "Target"
        },
        "verify": {
          "default": false,
          "description": "Target not confirmed by rule data; check it",
          "title": "Verify",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "Vulnerability": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "cvss": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cvss"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "fixed_versions": {
          "items": {
            "type": "string"
          },
          "title": "Fixed Versions",
          "type": "array"
        },
        "id": {
          "description": "CVE, GHSA or OSV id",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "description": "critical, high, medium, low or unknown",
          "title": "Severity",
          "type": "string"
        },
        "sources": {
          "description": "dependency-check, osv",
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "severity"
      ],
      "title": "Vulnerability",
      "type": "object"
    }
  },
  "$id": "legacy-audit/facts/library.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "title": "Artifact",
      "type": "string"
    },
    "cves": {
      "items": {
        "type": "string"
      },
      "title": "Cves",
      "type": "array"
    },
    "declared": {
      "default": true,
      "title": "Declared",
      "type": "boolean"
    },
    "eol": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eol"
    },
    "eol_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eol Date"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "group": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Group"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "language": {
      "default": "java",
      "title": "Language",
      "type": "string"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "max_severity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Severity"
    },
    "recommendation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Recommendation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recommended_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommended Version"
    },
    "replacement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replacement"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    },
    "sha1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha1"
    },
    "source": {
      "description": "maven, gradle, ivy, jar, npm, js-file, nuget, com (VB6 references)",
      "title": "Source",
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    },
    "vulnerabilities": {
      "items": {
        "$ref": "#/$defs/Vulnerability"
      },
      "title": "Vulnerabilities",
      "type": "array"
    },
    "where_used": {
      "items": {
        "type": "string"
      },
      "title": "Where Used",
      "type": "array"
    }
  },
  "required": [
    "id",
    "artifact",
    "source"
  ],
  "title": "Library",
  "type": "object"
}
