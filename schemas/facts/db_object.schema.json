{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "description": "Where a fact was found. ``line`` is None when the fact is about the whole file.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        }
      },
      "required": [
        "file"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "$id": "legacy-audit/facts/db_object.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "crud": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "Operation (C/R/U/D) to referencing ids",
      "title": "Crud",
      "type": "object"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "object_type": {
      "title": "Object Type",
      "type": "string"
    },
    "referenced_by": {
      "items": {
        "type": "string"
      },
      "title": "Referenced By",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "object_type"
  ],
  "title": "DbObject",
  "type": "object"
}
