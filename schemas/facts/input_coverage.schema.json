{
  "$defs": {
    "CoverageStatus": {
      "enum": [
        "present",
        "missing"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Where a fact was found. ``line`` is None when the fact is about the whole file.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        }
      },
      "required": [
        "file"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "$id": "legacy-audit/facts/input_coverage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "file_count": {
      "default": 0,
      "title": "File Count",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CoverageStatus"
    }
  },
  "required": [
    "id",
    "kind",
    "label",
    "status",
    "path"
  ],
  "title": "InputCoverage",
  "type": "object"
}
