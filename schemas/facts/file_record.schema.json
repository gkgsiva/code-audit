{
  "$defs": {
    "Category": {
      "enum": [
        "source",
        "config",
        "build",
        "sql",
        "screen",
        "job",
        "script",
        "binary",
        "test",
        "generated",
        "doc",
        "other"
      ],
      "title": "Category",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Where a fact was found. ``line`` is None when the fact is about the whole file.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        }
      },
      "required": [
        "file"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Origin": {
      "enum": [
        "source",
        "input"
      ],
      "title": "Origin",
      "type": "string"
    }
  },
  "$id": "legacy-audit/facts/file_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "category": {
      "$ref": "#/$defs/Category"
    },
    "component": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Component"
    },
    "encoding": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Encoding"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "loc_blank": {
      "default": 0,
      "title": "Loc Blank",
      "type": "integer"
    },
    "loc_code": {
      "default": 0,
      "title": "Loc Code",
      "type": "integer"
    },
    "loc_comment": {
      "default": 0,
      "title": "Loc Comment",
      "type": "integer"
    },
    "origin": {
      "$ref": "#/$defs/Origin",
      "default": "source"
    },
    "path": {
      "description": "Path relative to the source root, POSIX style",
      "title": "Path",
      "type": "string"
    },
    "root": {
      "description": "Name of the source root the file belongs to",
      "title": "Root",
      "type": "string"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    },
    "size": {
      "title": "Size",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "path",
    "root",
    "language",
    "category",
    "size",
    "sha256"
  ],
  "title": "FileRecord",
  "type": "object"
}
