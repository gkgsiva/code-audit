{
  "$defs": {
    "AnalyzerCoverage": {
      "additionalProperties": false,
      "description": "How much of the files an analyzer handled it could actually parse.",
      "properties": {
        "coverage_pct": {
          "default": 100.0,
          "title": "Coverage Pct",
          "type": "number"
        },
        "files": {
          "default": 0,
          "title": "Files",
          "type": "integer"
        },
        "lines": {
          "default": 0,
          "title": "Lines",
          "type": "integer"
        },
        "regions": {
          "description": "First 50 unparsed regions",
          "items": {
            "$ref": "#/$defs/UnparsedRegion"
          },
          "title": "Regions",
          "type": "array"
        },
        "unparsed_lines": {
          "default": 0,
          "title": "Unparsed Lines",
          "type": "integer"
        }
      },
      "title": "AnalyzerCoverage",
      "type": "object"
    },
    "CoverageStatus": {
      "enum": [
        "present",
        "missing"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Where a fact was found. ``line`` is None when the fact is about the whole file.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        }
      },
      "required": [
        "file"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "InputCoverage": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "file_count": {
          "default": 0,
          "title": "File Count",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CoverageStatus"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "status",
        "path"
      ],
      "title": "InputCoverage",
      "type": "object"
    },
    "SourceInfo": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "name",
        "type",
        "path"
      ],
      "title": "SourceInfo",
      "type": "object"
    },
    "UnparsedRegion": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "title": "End",
          "type": "integer"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start",
        "end",
        "reason"
      ],
      "title": "UnparsedRegion",
      "type": "object"
    },
    "VulnerabilitySource": {
      "additionalProperties": false,
      "description": "One vulnerability data source for this run (tool run or imported report).",
      "properties": {
        "database_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Database Date"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "name": {
          "description": "dependency-check or osv-scanner",
          "title": "Name",
          "type": "string"
        },
        "reports": {
          "items": {
            "type": "string"
          },
          "title": "Reports",
          "type": "array"
        },
        "status": {
          "description": "ran, imported, missing or failed",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "VulnerabilitySource",
      "type": "object"
    }
  },
  "$id": "legacy-audit/facts/run_info.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Describes one scan run; written as ``run.json``. Not part of the compared facts.",
  "properties": {
    "analyzers": {
      "additionalProperties": {
        "$ref": "#/$defs/AnalyzerCoverage"
      },
      "title": "Analyzers",
      "type": "object"
    },
    "application": {
      "title": "Application",
      "type": "string"
    },
    "config_hash": {
      "title": "Config Hash",
      "type": "string"
    },
    "config_path": {
      "title": "Config Path",
      "type": "string"
    },
    "counting_rules": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Counting Rules",
      "type": "object"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/InputCoverage"
      },
      "title": "Coverage",
      "type": "array"
    },
    "files_analyzed": {
      "default": 0,
      "title": "Files Analyzed",
      "type": "integer"
    },
    "files_cached": {
      "default": 0,
      "title": "Files Cached",
      "type": "integer"
    },
    "files_removed": {
      "default": 0,
      "title": "Files Removed",
      "type": "integer"
    },
    "files_total": {
      "default": 0,
      "title": "Files Total",
      "type": "integer"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "full_scan": {
      "default": false,
      "title": "Full Scan",
      "type": "boolean"
    },
    "overrides": {
      "additionalProperties": true,
      "title": "Overrides",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceInfo"
      },
      "title": "Sources",
      "type": "array"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "target": {
      "additionalProperties": true,
      "description": "The migration target (audit.yaml > target.profile), as in data/target.json",
      "title": "Target",
      "type": "object"
    },
    "timings": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Timings",
      "type": "object"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    },
    "unresolved_references": {
      "default": 0,
      "title": "Unresolved References",
      "type": "integer"
    },
    "vulnerability_sources": {
      "items": {
        "$ref": "#/$defs/VulnerabilitySource"
      },
      "title": "Vulnerability Sources",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "tool_version",
    "started_at",
    "config_path",
    "config_hash",
    "application"
  ],
  "title": "RunInfo",
  "type": "object"
}
