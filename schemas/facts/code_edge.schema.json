{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "description": "Where a fact was found. ``line`` is None when the fact is about the whole file.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        }
      },
      "required": [
        "file"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "$id": "legacy-audit/facts/code_edge.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "description": "calls, uses, invokes, runs, triggers, includes, forwards, renders, submits, links, reads, writes, contains or depends-on",
      "title": "Kind",
      "type": "string"
    },
    "resolved": {
      "default": true,
      "title": "Resolved",
      "type": "boolean"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "target": {
      "title": "Target",
      "type": "string"
    }
  },
  "required": [
    "id",
    "source",
    "target",
    "kind"
  ],
  "title": "CodeEdge",
  "type": "object"
}
