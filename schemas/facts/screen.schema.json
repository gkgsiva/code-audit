{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "description": "Where a fact was found. ``line`` is None when the fact is about the whole file.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        }
      },
      "required": [
        "file"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "$id": "legacy-audit/facts/screen.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action"
    },
    "complexity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Complexity"
    },
    "component": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Component"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "fields_count": {
      "default": 0,
      "title": "Fields Count",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "partial": {
      "default": false,
      "title": "Partial",
      "type": "boolean"
    },
    "technology": {
      "title": "Technology",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "technology"
  ],
  "title": "Screen",
  "type": "object"
}
