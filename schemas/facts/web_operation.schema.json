{
  "$id": "legacy-audit/facts/web_operation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One operation of a web service: an HTTP method and path, or a SOAP operation.",
  "properties": {
    "file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File"
    },
    "handler": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Class and method implementing or calling it",
      "title": "Handler"
    },
    "line": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Line"
    },
    "method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "GET, POST, ... (REST); None for SOAP",
      "title": "Method"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "URL path (REST) or endpoint, when known",
      "title": "Path"
    },
    "service_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The Service fact (offered operations)",
      "title": "Service Id"
    }
  },
  "required": [
    "name"
  ],
  "title": "WebOperation",
  "type": "object"
}
