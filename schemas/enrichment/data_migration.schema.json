{
  "$defs": {
    "BuiltFrom": {
      "additionalProperties": false,
      "properties": {
        "facts_hash_by_input": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "sha256 of each fact file (and 'stage:<name>' of each upstream stage)",
          "title": "Facts Hash By Input",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "facts_hash_by_input"
      ],
      "title": "BuiltFrom",
      "type": "object"
    },
    "DataObjectPlan": {
      "additionalProperties": false,
      "properties": {
        "approach": {
          "enum": [
            "auto",
            "convert",
            "rewrite",
            "retire"
          ],
          "title": "Approach",
          "type": "string"
        },
        "assumption": {
          "default": false,
          "title": "Assumption",
          "type": "boolean"
        },
        "db_object_id": {
          "title": "Db Object Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "db_object_id",
        "approach"
      ],
      "title": "DataObjectPlan",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "required": [
        "file"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Figure": {
      "additionalProperties": false,
      "description": "A number shown to readers. Never typed by hand: copied from the scan output.",
      "properties": {
        "estimate": {
          "default": false,
          "description": "True when the agent derived it (say how in note)",
          "title": "Estimate",
          "type": "boolean"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path in audit-summary.json, or effort.<key> in effort.json",
          "title": "Metric"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "Figure",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "default": "copilot-agent",
          "title": "Author",
          "type": "string"
        },
        "built_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuiltFrom"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stamped by `legacy-audit validate`; leave it out when (re)writing"
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "overrides_noted": {
          "description": "Overrides from audit-overrides.yaml (run.json > overrides) this stage took into account",
          "items": {
            "type": "string"
          },
          "title": "Overrides Noted",
          "type": "array"
        },
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage"
      ],
      "title": "Meta",
      "type": "object"
    }
  },
  "$id": "legacy-audit/enrichment/data_migration.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "figures": {
      "items": {
        "$ref": "#/$defs/Figure"
      },
      "title": "Figures",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "objects": {
      "items": {
        "$ref": "#/$defs/DataObjectPlan"
      },
      "title": "Objects",
      "type": "array"
    },
    "strategy": {
      "default": "",
      "title": "Strategy",
      "type": "string"
    }
  },
  "required": [
    "meta"
  ],
  "title": "DataMigration",
  "type": "object"
}
