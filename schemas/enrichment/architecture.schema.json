{
  "$defs": {
    "ArchNote": {
      "additionalProperties": false,
      "properties": {
        "assumption": {
          "default": false,
          "title": "Assumption",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ArchNote",
      "type": "object"
    },
    "BuiltFrom": {
      "additionalProperties": false,
      "properties": {
        "facts_hash_by_input": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "sha256 of each fact file (and 'stage:<name>' of each upstream stage)",
          "title": "Facts Hash By Input",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "facts_hash_by_input"
      ],
      "title": "BuiltFrom",
      "type": "object"
    },
    "DeploymentUnit": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "type": "string"
          },
          "title": "Components",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "runtime": {
          "title": "Runtime",
          "type": "string"
        }
      },
      "required": [
        "name",
        "runtime"
      ],
      "title": "DeploymentUnit",
      "type": "object"
    },
    "Diagram": {
      "additionalProperties": false,
      "properties": {
        "mermaid": {
          "title": "Mermaid",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "mermaid"
      ],
      "title": "Diagram",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "required": [
        "file"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Layer": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "type": "string"
          },
          "title": "Components",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Layer",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "default": "copilot-agent",
          "title": "Author",
          "type": "string"
        },
        "built_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuiltFrom"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stamped by `legacy-audit validate`; leave it out when (re)writing"
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "overrides_noted": {
          "description": "Overrides from audit-overrides.yaml (run.json > overrides) this stage took into account",
          "items": {
            "type": "string"
          },
          "title": "Overrides Noted",
          "type": "array"
        },
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage"
      ],
      "title": "Meta",
      "type": "object"
    }
  },
  "$id": "legacy-audit/enrichment/architecture.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "deployment_units": {
      "items": {
        "$ref": "#/$defs/DeploymentUnit"
      },
      "title": "Deployment Units",
      "type": "array"
    },
    "diagrams": {
      "items": {
        "$ref": "#/$defs/Diagram"
      },
      "title": "Diagrams",
      "type": "array"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/Layer"
      },
      "title": "Layers",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "notes": {
      "items": {
        "$ref": "#/$defs/ArchNote"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "meta"
  ],
  "title": "Architecture",
  "type": "object"
}
