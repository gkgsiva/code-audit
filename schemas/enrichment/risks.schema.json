{
  "$defs": {
    "BuiltFrom": {
      "additionalProperties": false,
      "properties": {
        "facts_hash_by_input": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "sha256 of each fact file (and 'stage:<name>' of each upstream stage)",
          "title": "Facts Hash By Input",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "facts_hash_by_input"
      ],
      "title": "BuiltFrom",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "required": [
        "file"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "default": "copilot-agent",
          "title": "Author",
          "type": "string"
        },
        "built_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuiltFrom"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stamped by `legacy-audit validate`; leave it out when (re)writing"
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "overrides_noted": {
          "description": "Overrides from audit-overrides.yaml (run.json > overrides) this stage took into account",
          "items": {
            "type": "string"
          },
          "title": "Overrides Noted",
          "type": "array"
        },
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Risk": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "default": false,
          "title": "Accepted",
          "type": "boolean"
        },
        "assumption": {
          "default": false,
          "title": "Assumption",
          "type": "boolean"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "likelihood": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Likelihood",
          "type": "string"
        },
        "mitigation": {
          "title": "Mitigation",
          "type": "string"
        },
        "owner": {
          "default": "TBD",
          "title": "Owner",
          "type": "string"
        },
        "related_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Ids",
          "type": "array"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "severity",
        "likelihood",
        "mitigation"
      ],
      "title": "Risk",
      "type": "object"
    }
  },
  "$id": "legacy-audit/enrichment/risks.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "risks": {
      "items": {
        "$ref": "#/$defs/Risk"
      },
      "title": "Risks",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "risks"
  ],
  "title": "Risks",
  "type": "object"
}
