{
  "$defs": {
    "BuiltFrom": {
      "additionalProperties": false,
      "properties": {
        "facts_hash_by_input": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "sha256 of each fact file (and 'stage:<name>' of each upstream stage)",
          "title": "Facts Hash By Input",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "facts_hash_by_input"
      ],
      "title": "BuiltFrom",
      "type": "object"
    },
    "ComponentClass": {
      "additionalProperties": false,
      "properties": {
        "assumption": {
          "default": false,
          "title": "Assumption",
          "type": "boolean"
        },
        "capability": {
          "description": "Business capability or module, in business words",
          "title": "Capability",
          "type": "string"
        },
        "component": {
          "title": "Component",
          "type": "string"
        },
        "criticality": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Criticality",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "enum": [
            "online",
            "batch",
            "integration",
            "library",
            "data",
            "mixed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "reclassified_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Scanner type, when overridden",
          "title": "Reclassified From"
        }
      },
      "required": [
        "component",
        "capability",
        "kind",
        "criticality",
        "reason"
      ],
      "title": "ComponentClass",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "required": [
        "file"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "default": "copilot-agent",
          "title": "Author",
          "type": "string"
        },
        "built_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuiltFrom"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stamped by `legacy-audit validate`; leave it out when (re)writing"
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "overrides_noted": {
          "description": "Overrides from audit-overrides.yaml (run.json > overrides) this stage took into account",
          "items": {
            "type": "string"
          },
          "title": "Overrides Noted",
          "type": "array"
        },
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage"
      ],
      "title": "Meta",
      "type": "object"
    }
  },
  "$id": "legacy-audit/enrichment/classification.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/ComponentClass"
      },
      "title": "Components",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    }
  },
  "required": [
    "meta",
    "components"
  ],
  "title": "Classification",
  "type": "object"
}
