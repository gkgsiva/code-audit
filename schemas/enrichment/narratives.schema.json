{
  "$defs": {
    "BuiltFrom": {
      "additionalProperties": false,
      "properties": {
        "facts_hash_by_input": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "sha256 of each fact file (and 'stage:<name>' of each upstream stage)",
          "title": "Facts Hash By Input",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "facts_hash_by_input"
      ],
      "title": "BuiltFrom",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "default": "copilot-agent",
          "title": "Author",
          "type": "string"
        },
        "built_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuiltFrom"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stamped by `legacy-audit validate`; leave it out when (re)writing"
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "overrides_noted": {
          "description": "Overrides from audit-overrides.yaml (run.json > overrides) this stage took into account",
          "items": {
            "type": "string"
          },
          "title": "Overrides Noted",
          "type": "array"
        },
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Narrative": {
      "additionalProperties": false,
      "properties": {
        "key_messages": {
          "items": {
            "type": "string"
          },
          "title": "Key Messages",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Narrative",
      "type": "object"
    }
  },
  "$id": "legacy-audit/enrichment/narratives.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "architect": {
      "$ref": "#/$defs/Narrative"
    },
    "developer": {
      "$ref": "#/$defs/Narrative"
    },
    "executive": {
      "$ref": "#/$defs/Narrative"
    },
    "functional": {
      "$ref": "#/$defs/Narrative"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    }
  },
  "required": [
    "meta",
    "executive",
    "architect",
    "functional",
    "developer"
  ],
  "title": "Narratives",
  "type": "object"
}
