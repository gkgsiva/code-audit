{
  "$defs": {
    "BuiltFrom": {
      "additionalProperties": false,
      "properties": {
        "facts_hash_by_input": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "sha256 of each fact file (and 'stage:<name>' of each upstream stage)",
          "title": "Facts Hash By Input",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "facts_hash_by_input"
      ],
      "title": "BuiltFrom",
      "type": "object"
    },
    "Diagram": {
      "additionalProperties": false,
      "properties": {
        "mermaid": {
          "title": "Mermaid",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "mermaid"
      ],
      "title": "Diagram",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "required": [
        "file"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "default": "copilot-agent",
          "title": "Author",
          "type": "string"
        },
        "built_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuiltFrom"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stamped by `legacy-audit validate`; leave it out when (re)writing"
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "overrides_noted": {
          "description": "Overrides from audit-overrides.yaml (run.json > overrides) this stage took into account",
          "items": {
            "type": "string"
          },
          "title": "Overrides Noted",
          "type": "array"
        },
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage"
      ],
      "title": "Meta",
      "type": "object"
    },
    "PlatformChange": {
      "additionalProperties": false,
      "description": "What replaces one product of today's platform: an application or web server, a runtime\n(.NET Framework, Node.js, Java) or a desktop or UI framework (VB6, WinForms, AngularJS).",
      "properties": {
        "assumption": {
          "default": false,
          "title": "Assumption",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "name": {
          "description": "The product as the tech stack names it, e.g. 'Oracle WebLogic'",
          "title": "Name",
          "type": "string"
        },
        "target": {
          "description": "What replaces it on the target, one line",
          "title": "Target",
          "type": "string"
        },
        "tech_ids": {
          "description": "Its tech_stack ids (tech:...), every version",
          "items": {
            "type": "string"
          },
          "title": "Tech Ids",
          "type": "array"
        },
        "today": {
          "default": "",
          "description": "What it does for the application today, one line",
          "title": "Today",
          "type": "string"
        }
      },
      "required": [
        "name",
        "target"
      ],
      "title": "PlatformChange",
      "type": "object"
    },
    "TargetComponent": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "platform": {
          "description": "GCP service, e.g. Cloud Run, Cloud SQL for PostgreSQL",
          "title": "Platform",
          "type": "string"
        },
        "replaces": {
          "description": "Legacy component names",
          "items": {
            "type": "string"
          },
          "title": "Replaces",
          "type": "array"
        },
        "technology": {
          "description": "e.g. Spring Boot 4 on Java 25, Angular 21",
          "title": "Technology",
          "type": "string"
        }
      },
      "required": [
        "name",
        "technology",
        "platform"
      ],
      "title": "TargetComponent",
      "type": "object"
    }
  },
  "$id": "legacy-audit/enrichment/target_architecture.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/TargetComponent"
      },
      "title": "Components",
      "type": "array"
    },
    "diagrams": {
      "items": {
        "$ref": "#/$defs/Diagram"
      },
      "title": "Diagrams",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "platform_changes": {
      "description": "One entry per application server, web server and runtime in the tech stack (and each desktop or UI framework that goes away): what replaces it",
      "items": {
        "$ref": "#/$defs/PlatformChange"
      },
      "title": "Platform Changes",
      "type": "array"
    },
    "principles": {
      "items": {
        "type": "string"
      },
      "title": "Principles",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "components"
  ],
  "title": "TargetArchitecture",
  "type": "object"
}
