{
  "$defs": {
    "BuiltFrom": {
      "additionalProperties": false,
      "properties": {
        "facts_hash_by_input": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "sha256 of each fact file (and 'stage:<name>' of each upstream stage)",
          "title": "Facts Hash By Input",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "facts_hash_by_input"
      ],
      "title": "BuiltFrom",
      "type": "object"
    },
    "Figure": {
      "additionalProperties": false,
      "description": "A number shown to readers. Never typed by hand: copied from the scan output.",
      "properties": {
        "estimate": {
          "default": false,
          "description": "True when the agent derived it (say how in note)",
          "title": "Estimate",
          "type": "boolean"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path in audit-summary.json, or effort.<key> in effort.json",
          "title": "Metric"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "Figure",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "default": "copilot-agent",
          "title": "Author",
          "type": "string"
        },
        "built_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuiltFrom"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stamped by `legacy-audit validate`; leave it out when (re)writing"
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "overrides_noted": {
          "description": "Overrides from audit-overrides.yaml (run.json > overrides) this stage took into account",
          "items": {
            "type": "string"
          },
          "title": "Overrides Noted",
          "type": "array"
        },
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage"
      ],
      "title": "Meta",
      "type": "object"
    },
    "TeamRole": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "count"
      ],
      "title": "TeamRole",
      "type": "object"
    },
    "Wave": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "type": "string"
          },
          "title": "Components",
          "type": "array"
        },
        "depends_on": {
          "description": "Other wave names",
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "duration_months": {
          "minimum": 1,
          "title": "Duration Months",
          "type": "integer"
        },
        "effort": {
          "items": {
            "$ref": "#/$defs/Figure"
          },
          "title": "Effort",
          "type": "array"
        },
        "goal": {
          "title": "Goal",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "start_month": {
          "minimum": 0,
          "title": "Start Month",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "order",
        "goal",
        "start_month",
        "duration_months"
      ],
      "title": "Wave",
      "type": "object"
    }
  },
  "$id": "legacy-audit/enrichment/plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approach": {
      "title": "Approach",
      "type": "string"
    },
    "decisions_needed": {
      "items": {
        "type": "string"
      },
      "title": "Decisions Needed",
      "type": "array"
    },
    "effort": {
      "description": "Ranges from effort.json",
      "items": {
        "$ref": "#/$defs/Figure"
      },
      "title": "Effort",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "next_steps": {
      "items": {
        "type": "string"
      },
      "title": "Next Steps",
      "type": "array"
    },
    "team": {
      "items": {
        "$ref": "#/$defs/TeamRole"
      },
      "title": "Team",
      "type": "array"
    },
    "waves": {
      "items": {
        "$ref": "#/$defs/Wave"
      },
      "title": "Waves",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "approach",
    "waves"
  ],
  "title": "Plan",
  "type": "object"
}
